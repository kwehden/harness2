+def omits_temperature() -> bool:
+    """Whether the caller asked for judge requests that carry no temperature.
+
+    The harness sets JUDGE_OMIT_TEMPERATURE for a route whose judge model
+    rejects the fixed temperature=0.0 below, so that the model's own default
+    stands. Unset, requests keep the deterministic temperature.
+    """
+    return os.environ.get("JUDGE_OMIT_TEMPERATURE", "").strip().lower() not in (
+        "",
+        "0",
+        "false",
+        "no",
+    )
+
+
+class JudgeClientWithoutTemperature:
+    """Narrow facade for the judge's `chat.completions.create`, called with no
+    temperature. Other client attributes are reached directly on the client."""
+
+    def __init__(self, client):
+        self._client = client
+        self.chat = SimpleNamespace(completions=SimpleNamespace(create=self._create))
+
+    def _create(self, **kwargs):
+        kwargs.pop("temperature", None)
+        return self._client.chat.completions.create(**kwargs)
+
+    def __getattr__(self, name):
+        return getattr(self._client, name)
+
+
