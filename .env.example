# Harness² model configuration. Copy to .env; shell variables take precedence.
# See docs/SETUP.md#models-and-credentials.

# --- Option A: Amazon Bedrock -------------------------------------------------
# Selected automatically by an amazon-bedrock/ executor (or HARNESS2_CLOUD=aws).
# Use least-privilege AWS credentials with access to the selected models.
# Leave AWS_PROFILE unset for the default shared profile or attached IAM role.
# AWS_PROFILE=bedrock
AWS_REGION=us-west-2
HARNESS2_SOLVER_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
HARNESS2_IMPROVER_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
# Bare Bedrock ID; LAB requires a Claude judge with adaptive thinking.
# Confirm inference-profile availability and access in your account and region.
HARNESS2_JUDGE_MODEL=us.anthropic.claude-haiku-5-5

# --- Option B: Google Vertex AI -----------------------------------------------
# Comment out Option A, then authenticate with
#   gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# HARNESS2_SOLVER_MODEL=google-vertex/gemini-3.5-flash
# HARNESS2_IMPROVER_MODEL=google-vertex/gemini-3.5-flash
# HARNESS2_JUDGE_MODEL=gemini-3.5-flash

# --- Optional -------------------------------------------------------------------
# HARNESS2_RUNS_DIR=runs
# Codex executor; harness2-bridge prints these values.
# HARNESS2_CODEX_BASE_URL=
# HARNESS2_CODEX_API_KEY=
# HARNESS2_CODEX_MODEL=
